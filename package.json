{
  "name": "mcgill-courses",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm --dir client run build",
    "cy:e2e": "pnpm --dir client run cy:e2e",
    "cy:open-e2e": "pnpm --dir client run cy:open-e2e",
    "cy:open-unit": "pnpm --dir client run cy:open-unit",
    "cy:run-e2e": "pnpm --dir client run cy:run-e2e",
    "cy:run-unit": "pnpm --dir client run cy:run-unit",
    "dev": "pnpm --dir client run dev",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "knip": "pnpm --dir client run knip",
    "lint": "pnpm --dir client run lint",
    "prepare": "husky",
    "preview": "pnpm --dir client run preview",
    "test": "pnpm --dir client run test",
    "test:watch": "pnpm --dir client run test:watch"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}

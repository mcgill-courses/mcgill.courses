amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"

local hook_steps = new Mapping<String, Step> {
  ["cargo-fmt"] {
    check = "cargo fmt --check -- {{files}}"
    fix = "cargo fmt -- {{files}}"
    glob = List("**/*.rs")
  }
  ["eslint"] {
    check = "cd {{workspace}} && pnpm exec eslint --no-warn-ignored {{workspace_files}}"
    depends = List("prettier")
    glob = List("client/**/*.ts", "client/**/*.tsx")
    workspace_indicator = "package.json"
  }
  ["prettier"] {
    check = "cd {{workspace}} && pnpm exec prettier --check {{workspace_files}}"
    fix = "cd {{workspace}} && pnpm exec prettier --write {{workspace_files}}"
    glob = List("client/**/*.js", "client/**/*.json", "client/**/*.ts", "client/**/*.tsx")
    workspace_indicator = "package.json"
  }
}

hooks {
  ["check"] {
    steps = hook_steps
  }
  ["fix"] {
    fix = true
    steps = hook_steps
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = hook_steps
  }
}
